# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (database + legacy storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side scripts only (never expose to the browser):
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email (see EMAIL_SETUP.md) ---
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Backblaze B2 (media storage)
# Create an application key restricted to the `portfolio-elsrael` bucket with
# listFiles + readFiles + writeFiles + deleteFiles capabilities.
#
# deleteFiles is needed by /api/b2/delete (replacing a featured image, or
# removing a post/project). Deletion goes through B2's S3-compatible endpoint
# with a pinned versionId, because `b2_delete_file` is refused on this account
# (it 404s for a fileId that `b2_get_file_info` confirms is valid). Deleting by
# version also removes hide markers — a plain S3 DELETE only writes one, which
# shows up in the console as a 0 KB file.
# ---------------------------------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=portfolio-elsrael

# Optional overrides for the S3-compatible endpoint used to delete objects.
# Defaults match the us-east-005 region.
B2_S3_API_URL=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005

# Public download host for the bucket's region.
# us-east-005 -> https://f005.backblazeb2.com
# If omitted, the uploader uses the downloadUrl returned by B2 on authorize.
B2_DOWNLOAD_URL=https://f005.backblazeb2.com

# Public base the app renders media from (see src/utils/mediaUrl.ts).
NEXT_PUBLIC_B2_PUBLIC_URL=https://f005.backblazeb2.com/file/portfolio-elsrael

# Default --root for scripts/upload-media-to-b2.mjs (the converted WebP export).
MEDIA_ROOT=
